<local:ConflictViewBase x:Class="SkyScope.UI.ProblemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyScope.UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConflictViewResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SeverityBadge" TargetType="Border">
                <Setter Property="Background"   Value="{StaticResource SeverityWarningBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding"      Value="7,2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                        <Setter Property="Background" Value="{StaticResource SeverityErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="ProblemEntryTemplate">
                <Border Style="{StaticResource ConflictSourceCard}" Tag="{Binding}">
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Open File" Click="OpenFileForRow_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SeverityBadge}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SeverityLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#2E3440"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#ECEFF4" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" Text="{Binding LineLabel}" FontSize="10"
                                       Foreground="#8C9BB5" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#D8DEE9"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <TextBlock Text="{Binding LineText}" FontSize="10" FontFamily="Consolas"
                                   Foreground="#8C9BB5" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LineText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ProblemFileCardTemplate">
                <Border Style="{StaticResource ConflictItemContainer}">
                    <StackPanel>
                        <Button Tag="{Binding}" Click="ConflictHeader_Click" Style="{StaticResource ConflictHeaderButton}">
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="10" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SeverityWarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WorstSeverity}" Value="Error">
                                                    <Setter Property="Background" Value="{StaticResource SeverityErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ProblemCount, StringFormat={}{0} issue(s)}"
                                               FontSize="9" FontWeight="SemiBold" Foreground="#2E3440"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#ECEFF4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="2" FontSize="10" Foreground="#8C9BB5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▼"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource ConflictAccordionPanel}">
                            <ItemsControl ItemsSource="{Binding FilteredProblems}"
                                          ItemTemplate="{StaticResource ProblemEntryTemplate}"
                                          Margin="12,0,12,10"/>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0" Background="#313744" CornerRadius="4" Margin="0,0,0,8" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2E3440" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#ECEFF4" CaretBrush="#ECEFF4"
                                 FontSize="11" Height="28" VerticalContentAlignment="Center"
                                 Padding="28,0,28,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Filter by filename or message…" FontSize="11" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="28,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" FontSize="15" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsHitTestVisible="False"/>
                        <Button Style="{StaticResource ClearTextButton}"
                                local:TextBoxAssist.ClearTarget="{Binding ElementName=SearchBox}"/>
                    </Grid>
                </Border>

                <CheckBox x:Name="ShowWarningsCheckBox" Grid.Column="1"
                          Content="Show warnings"
                          Style="{StaticResource FilterToggleStyle}"
                          Margin="0,0,8,0" VerticalAlignment="Center"
                          Checked="ShowWarningsCheckBox_Changed" Unchecked="ShowWarningsCheckBox_Changed"
                          ToolTip="Uncheck to show only Error-severity issues"/>

                <TextBlock x:Name="CountText" Grid.Column="2"
                           FontSize="10" Foreground="#8C9BB5"
                           VerticalAlignment="Center" Margin="0,0,2,0"/>
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="Run an analysis to populate this view."
                   FontSize="11" Foreground="#4C566A"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="Visible"/>

        <!-- File list (virtualized) -->
        <ItemsControl x:Name="FileList" Grid.Row="1" Style="{StaticResource VirtualizedNpcListStyle}"
                      ItemTemplate="{StaticResource ProblemFileCardTemplate}"/>

    </Grid>
</local:ConflictViewBase>
