<UserControl x:Class="SkyScope.UI.NpcConflictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="NpcTabPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B5CEA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NpcTabAccentButton" TargetType="Button" BasedOn="{StaticResource NpcTabPrimaryButton}">
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7090BC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NpcTabDangerButton" TargetType="Button" BasedOn="{StaticResource NpcTabPrimaryButton}">
            <Setter Property="Background" Value="#BF616A"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CF7177"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#8C9BB5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="#4C566A" CornerRadius="3" Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5E81AC"/>
                                <Setter Property="Foreground" Value="#ECEFF4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A6478"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NpcHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Border Grid.Row="0" Background="#313744" CornerRadius="4" Margin="0,0,0,8" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Border Grid.Column="0" Background="#2E3440" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#ECEFF4" CaretBrush="#ECEFF4"
                                 FontSize="11" Height="28" VerticalContentAlignment="Center"
                                 Padding="28,0,8,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Search NPCs…" FontSize="11" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="28,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" FontSize="15" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Type filter buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="FilterAButton" Content="A" Width="26" Height="26" Margin="2,0"
                            Background="#EBCB8B" Foreground="#2E3440"
                            FontWeight="Bold" FontSize="11" Padding="0"
                            Click="FilterA_Click" Cursor="Hand"
                            ToolTip="Toggle: Appearance conflicts"
                            Style="{StaticResource NpcTabPrimaryButton}"/>
                    <Button x:Name="FilterSButton" Content="S" Width="26" Height="26" Margin="2,0"
                            Background="#D08770" Foreground="#2E3440"
                            FontWeight="Bold" FontSize="11" Padding="0"
                            Click="FilterS_Click" Cursor="Hand"
                            ToolTip="Toggle: Skin conflicts"
                            Style="{StaticResource NpcTabPrimaryButton}"/>
                    <Button x:Name="FilterOButton" Content="O" Width="26" Height="26" Margin="2,0"
                            Background="#B48EAD" Foreground="#2E3440"
                            FontWeight="Bold" FontSize="11" Padding="0"
                            Click="FilterO_Click" Cursor="Hand"
                            ToolTip="Toggle: Outfit conflicts"
                            Style="{StaticResource NpcTabPrimaryButton}"/>
                    <Button x:Name="FilterSpButton" Content="Sp" Width="30" Height="26" Margin="2,0"
                            Background="#A3BE8C" Foreground="#2E3440"
                            FontWeight="Bold" FontSize="10" Padding="0"
                            Click="FilterSp_Click" Cursor="Hand"
                            ToolTip="Toggle: Spell conflicts"
                            Style="{StaticResource NpcTabPrimaryButton}"/>
                    <Button x:Name="FilterPButton" Content="P" Width="26" Height="26" Margin="2,0"
                            Background="#BF616A" Foreground="#2E3440"
                            FontWeight="Bold" FontSize="11" Padding="0"
                            Click="FilterP_Click" Cursor="Hand"
                            ToolTip="Toggle: Perk conflicts"
                            Style="{StaticResource NpcTabPrimaryButton}"/>
                </StackPanel>

                <!-- Sub-100% SPID filter -->
                <CheckBox x:Name="ShowLowChanceSpidCheckBox" Grid.Column="2"
                          Content="Show &lt;100% SPID Conflicts"
                          Style="{StaticResource FilterToggleStyle}"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Checked="SpidFilter_Changed"
                          Unchecked="SpidFilter_Changed"
                          ToolTip="When checked, also shows SPID conflicts where the rule has less than 100% chance"/>

                <!-- NPC count -->
                <TextBlock x:Name="NpcCountText" Grid.Column="3"
                           FontSize="10" Foreground="#8C9BB5"
                           VerticalAlignment="Center" Margin="0,0,2,0"/>
            </Grid>
        </Border>

        <!-- Empty / initial state -->
        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="Run analysis to populate this view."
                   FontSize="11" Foreground="#4C566A"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="Visible"/>

        <!-- NPC list (virtualized — scroll viewer lives inside the template) -->
        <ItemsControl x:Name="NpcList" Grid.Row="1"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3B4252" CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>

                                <!-- Header row (clickable) -->
                                <Button Tag="{Binding}" Click="NpcHeader_Click"
                                        Style="{StaticResource NpcHeaderButton}">
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NPC name + sub-text -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#ECEFF4"/>
                                            <TextBlock Text="{Binding SubText}"
                                                       FontSize="10" Foreground="#B8C5D5" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Type badges A / S / O -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="10,0">
                                            <Border Background="#EBCB8B" CornerRadius="3"
                                                    Padding="5,2" Margin="2,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAppearance}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="A" FontSize="9" FontWeight="Bold" Foreground="#2E3440"/>
                                            </Border>
                                            <Border Background="#D08770" CornerRadius="3"
                                                    Padding="5,2" Margin="2,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSkin}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="#2E3440"/>
                                            </Border>
                                            <Border Background="#B48EAD" CornerRadius="3"
                                                    Padding="5,2" Margin="2,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOutfit}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="O" FontSize="9" FontWeight="Bold" Foreground="#2E3440"/>
                                            </Border>
                                            <Border Background="#A3BE8C" CornerRadius="3"
                                                    Padding="5,2" Margin="2,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSpell}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Sp" FontSize="9" FontWeight="Bold" Foreground="#2E3440"/>
                                            </Border>
                                            <Border Background="#BF616A" CornerRadius="3"
                                                    Padding="5,2" Margin="2,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPerk}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="P" FontSize="9" FontWeight="Bold" Foreground="#ECEFF4"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Overall winner filename -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding OverallWinnerFileName}"
                                                   FontSize="10" Foreground="#A3BE8C"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OverallWinnerFileName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Expand/collapse chevron -->
                                        <TextBlock Grid.Column="3"
                                                   FontSize="9" Foreground="#4C566A"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▶"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▼"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>

                                <!-- Accordion panel (animated MaxHeight) -->
                                <Border MaxHeight="0" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                    To="3000" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                    To="0" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- Groups (filtered by active type filters) -->
                                    <ItemsControl ItemsSource="{Binding FilteredGroups}" Margin="12,4,12,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,0">

                                                    <!-- Group type header — full-width coloured strip -->
                                                    <Border Background="{Binding BadgeBrush}" CornerRadius="3"
                                                            Padding="10,6" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11" FontWeight="Bold" Foreground="#2E3440"/>
                                                    </Border>

                                                    <!-- Source cards -->
                                                    <ItemsControl ItemsSource="{Binding Sources}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="3" Margin="0,0,0,4" Padding="10,8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#434C5E"/>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#4E5A6E"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>

                                                                        <!-- Row 1: filename + badges -->
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding FileName}"
                                                                                       FontSize="12" FontWeight="SemiBold"
                                                                                       Foreground="#ECEFF4"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                <!-- Load position -->
                                                                                <Border Background="#4C566A" CornerRadius="3"
                                                                                        Padding="6,2" Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock FontSize="9" Foreground="#88C0D0">
                                                                                        <Run Text="{Binding LoadPosition, Mode=OneTime}"/>
                                                                                        <Run Text=" of "/>
                                                                                        <Run Text="{Binding TotalSources, Mode=OneTime}"/>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                                <!-- SPID badge -->
                                                                                <Border Background="#81A1C1" CornerRadius="3"
                                                                                        Padding="6,2" Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsSpid}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock Text="{Binding SpidBadgeText}"
                                                                                               FontSize="9" FontWeight="Bold"
                                                                                               Foreground="#ECEFF4"/>
                                                                                </Border>
                                                                                <!-- Winner badge (hidden for additive rule types) -->
                                                                                <Border Background="#A3BE8C" CornerRadius="3"
                                                                                        Padding="6,2" Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsAdditive}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock Text="WINS" FontSize="9"
                                                                                               FontWeight="Bold" Foreground="#2E3440"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- Row 2: rule value -->
                                                                        <TextBlock Text="{Binding ResolvedRuleDisplay}"
                                                                                   FontSize="10" Foreground="#A0AFBE"
                                                                                   Margin="0,4,0,0"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <!-- Row 3: context lines code block -->
                                                                        <Border Background="#272C38" CornerRadius="3"
                                                                                Margin="0,6,0,0" Padding="8,5">
                                                                            <StackPanel>

                                                                                <!-- Preceding line -->
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <StackPanel.Style>
                                                                                        <Style TargetType="StackPanel">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasPrecedingLine}" Value="False">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </StackPanel.Style>
                                                                                    <TextBlock Text="{Binding PrecedingLineNumber}"
                                                                                               Width="32" FontFamily="Consolas" FontSize="10"
                                                                                               Foreground="#6C7A8A" TextAlignment="Right"
                                                                                               Margin="0,0,8,0"/>
                                                                                    <TextBlock Text="{Binding PrecedingLine}"
                                                                                               FontFamily="Consolas" FontSize="10"
                                                                                               Foreground="#7B8899"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>

                                                                                <!-- Conflict line (highlighted) -->
                                                                                <Border Background="#353D4C" CornerRadius="2" Margin="0,1">
                                                                                    <Grid>
                                                                                        <Rectangle Width="2" HorizontalAlignment="Left"
                                                                                                   Fill="#88C0D0"/>
                                                                                        <StackPanel Orientation="Horizontal" Margin="6,2">
                                                                                            <TextBlock Text="{Binding LineNumber}"
                                                                                                       Width="32" FontFamily="Consolas" FontSize="10"
                                                                                                       Foreground="#6C7A8A" TextAlignment="Right"
                                                                                                       Margin="0,0,8,0"/>
                                                                                            <TextBlock Text="{Binding ConflictLineText}"
                                                                                                       FontFamily="Consolas" FontSize="10"
                                                                                                       Foreground="#ECEFF4"
                                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- Following line -->
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <StackPanel.Style>
                                                                                        <Style TargetType="StackPanel">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasFollowingLine}" Value="False">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </StackPanel.Style>
                                                                                    <TextBlock Text="{Binding FollowingLineNumber}"
                                                                                               Width="32" FontFamily="Consolas" FontSize="10"
                                                                                               Foreground="#6C7A8A" TextAlignment="Right"
                                                                                               Margin="0,0,8,0"/>
                                                                                    <TextBlock Text="{Binding FollowingLine}"
                                                                                               FontFamily="Consolas" FontSize="10"
                                                                                               Foreground="#7B8899"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>

                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Row 4: file path -->
                                                                        <TextBlock Text="{Binding FilePath}"
                                                                                   FontSize="9" Foreground="#8C99A8"
                                                                                   Margin="0,4,0,0"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <!-- Row 5: buttons -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                            <!-- Make Winner — winner-takes-all types (Appearance/Skin/Outfit) -->
                                                                            <Button Content="Make Winner"
                                                                                    Tag="{Binding}"
                                                                                    Click="MakeWinner_Click">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource NpcTabPrimaryButton}">
                                                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsAdditive}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                            <!-- Remove — additive types (Spell/Perk) -->
                                                                            <Button Content="Remove"
                                                                                    Tag="{Binding}"
                                                                                    Click="RemoveSource_Click">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource NpcTabDangerButton}">
                                                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsAdditive}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                            <Button Content="Open File"
                                                                                    Tag="{Binding}"
                                                                                    Click="OpenFile_Click"
                                                                                    Style="{StaticResource NpcTabAccentButton}"/>
                                                                        </StackPanel>

                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </DataTemplate>
