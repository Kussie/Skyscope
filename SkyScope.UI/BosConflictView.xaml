<local:ConflictViewBase x:Class="SkyScope.UI.BosConflictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyScope.UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConflictViewResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Warning banner -->
        <Border Grid.Row="0" Background="#3D3010" BorderBrush="#EBCB8B" BorderThickness="0,0,0,1"
                Padding="12,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Foreground="#EBCB8B"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock FontSize="11" Foreground="#EBCB8B" TextWrapping="Wrap"
                           VerticalAlignment="Center">
                    <Run FontWeight="SemiBold" Text="Base Object Swapper support is incredibly limited and in development."/>
                    <Run Text="  Use at own risk."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Search bar -->
        <Border Grid.Row="1" Background="#313744" CornerRadius="4" Margin="0,0,0,8" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2E3440" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#ECEFF4" CaretBrush="#ECEFF4"
                                 FontSize="11" Height="28" VerticalContentAlignment="Center"
                                 Padding="28,0,28,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Search objects…" FontSize="11" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="28,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" FontSize="15" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsHitTestVisible="False"/>
                        <Button Style="{StaticResource ClearTextButton}"
                                local:TextBoxAssist.ClearTarget="{Binding ElementName=SearchBox}"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="ConflictCountText" Grid.Column="1"
                           FontSize="10" Foreground="#8C9BB5"
                           VerticalAlignment="Center" Margin="0,0,2,0"/>
            </Grid>
        </Border>

        <!-- Empty / initial state -->
        <TextBlock x:Name="EmptyText" Grid.Row="2"
                   Text="Run analysis to populate this view."
                   FontSize="11" Foreground="#4C566A"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="Visible"/>

        <!-- Conflict list (virtualized) -->
        <ItemsControl x:Name="ConflictList" Grid.Row="2"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ConflictItemContainer}">
                        <StackPanel>

                            <!-- Header row (clickable) -->
                            <Button Tag="{Binding}" Click="ConflictHeader_Click"
                                    Style="{StaticResource ConflictHeaderButton}">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Object name + sub-text -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#ECEFF4"/>
                                        <TextBlock Text="{Binding SubText}"
                                                   FontSize="10" Foreground="#B8C5D5" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SubText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Source count badge -->
                                    <Border Grid.Column="1" Background="#88C0D0" CornerRadius="3"
                                            Padding="5,2" Margin="4,0,8,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#2E3440">
                                            <Run Text="{Binding SourceCount, Mode=OneTime}"/>
                                            <Run Text=" files"/>
                                        </TextBlock>
                                    </Border>

                                    <!-- Expand/collapse chevron -->
                                    <TextBlock Grid.Column="2"
                                               FontSize="9" Foreground="#4C566A"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▼"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- Accordion panel -->
                            <Border Style="{StaticResource ConflictAccordionPanel}">

                                <!-- Source cards -->
                                <ItemsControl ItemsSource="{Binding Sources}" Margin="12,4,12,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ConflictSourceCard}">
                                                <StackPanel>

                                                    <!-- Row 1: filename + badges -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding FileName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#ECEFF4"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <!-- Load position -->
                                                            <Border Background="#4C566A" CornerRadius="3"
                                                                    Padding="6,2" Margin="4,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock FontSize="9" Foreground="#88C0D0">
                                                                    <Run Text="{Binding LoadPosition, Mode=OneTime}"/>
                                                                    <Run Text=" of "/>
                                                                    <Run Text="{Binding TotalSources, Mode=OneTime}"/>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- Chance badge -->
                                                            <Border Background="#81A1C1" CornerRadius="3"
                                                                    Padding="6,2" Margin="4,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasChance}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ChanceBadgeText}"
                                                                           FontSize="9" FontWeight="Bold"
                                                                           Foreground="#ECEFF4"/>
                                                            </Border>
                                                            <!-- WINS badge -->
                                                            <Border Background="#A3BE8C" CornerRadius="3"
                                                                    Padding="6,2" Margin="4,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="WINNER" FontSize="9"
                                                                           FontWeight="Bold" Foreground="#2E3440"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Row 2: swap target -->
                                                    <TextBlock Text="{Binding SwapTarget}"
                                                               FontSize="10" Foreground="#A0AFBE"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Row 3: conditional section (hidden when absent) -->
                                                    <TextBlock FontSize="9" Foreground="#8C99A8" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasConditionalSection}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="Condition: "/>
                                                        <Run Text="{Binding ConditionalSection}"/>
                                                    </TextBlock>

                                                    <!-- Row 4: code context -->
                                                    <local:CodeContextBlock
                                                        HasPrecedingLine="{Binding HasPrecedingLine}"
                                                        PrecedingLineNumber="{Binding PrecedingLineNumber}"
                                                        PrecedingLine="{Binding PrecedingLine}"
                                                        LineNumber="{Binding LineNumber}"
                                                        LineText="{Binding LineText}"
                                                        HasFollowingLine="{Binding HasFollowingLine}"
                                                        FollowingLineNumber="{Binding FollowingLineNumber}"
                                                        FollowingLine="{Binding FollowingLine}"
                                                        Margin="0,6,0,0"/>

                                                    <!-- Row 5: file path (relative to Skyrim root) -->
                                                    <TextBlock Text="{Binding DisplayPath}"
                                                               FontSize="9" Foreground="#8C99A8"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Row 6: action buttons -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <!-- Make Winner (hidden for the winner) -->
                                                        <Button Content="Make Winner"
                                                                Tag="{Binding}"
                                                                Click="MakeWinner_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConflictPrimaryButton}">
                                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Open File"
                                                                Tag="{Binding}"
                                                                Click="OpenFile_Click"
                                                                Style="{StaticResource ConflictAccentButton}"/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </Border>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</local:ConflictViewBase>
