<Window x:Class="SkyScope.UI.ConflictDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflict Details"
        Width="820" Height="580" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#2E3440"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <Style x:Key="LineNumStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4C566A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LineTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6C7A8A"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4C566A"/>
            <Setter Property="Foreground" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5C6880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MakeWinnerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B5CEA0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#8DAE78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#242933" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="NpcNameText" FontSize="17" FontWeight="Bold" Foreground="#ECEFF4"/>
                    <TextBlock x:Name="NpcSubText"  FontSize="10" Foreground="#4C566A" Margin="0,2,0,0"/>
                    <TextBlock x:Name="RuleTypeText" FontSize="10" Foreground="#88C0D0" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Close"
                        Width="72" Height="30"
                        VerticalAlignment="Top" Padding="0"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- Scrollable source list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12,16,0">
            <ItemsControl x:Name="SourcesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- Outer grid: card + hover overlay stacked -->
                        <Grid x:Name="CardGrid" Margin="0,0,0,12">

                            <!-- Card -->
                            <Border CornerRadius="4" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"  Value="#3B4252"/>
                                        <Setter Property="BorderBrush" Value="#4C566A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                <Setter Property="BorderBrush" Value="#A3BE8C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card header -->
                                    <Border Grid.Row="0" Background="#313744" CornerRadius="4,4,0,0" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF4"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           FontSize="9" Foreground="#6C7A8A"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="10" Padding="7,2" Margin="0,0,6,0" Background="#2E3440">
                                                    <TextBlock FontSize="9" Foreground="#81A1C1">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="#{0} of {1}">
                                                                <Binding Path="LoadPosition"/>
                                                                <Binding Path="TotalSources"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                                <Border CornerRadius="10" Padding="7,2" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSpid}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#3D2B50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding SpidBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="#C882F8"/>
                                                </Border>
                                                <Border CornerRadius="10" Padding="7,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#3D5C2E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="▶  winning" FontSize="9"
                                                               FontWeight="SemiBold" Foreground="#A3BE8C"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Line context -->
                                    <Border Grid.Row="1" Padding="12,8">
                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,2" Margin="0,1" CornerRadius="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                        <Setter Property="Background" Value="#2A3520"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding LineNumber}"
                                                                       Style="{StaticResource LineNumStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Text}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock"
                                                                           BasedOn="{StaticResource LineTextStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                                <Setter Property="Foreground" Value="#ECEFF4"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Rule value row -->
                                    <Border Grid.Row="2" Background="#282E3A" Padding="12,6" CornerRadius="0,0,4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Rule value: " FontSize="10" Foreground="#4C566A"/>
                                            <TextBlock Text="{Binding RuleValue}"
                                                       FontSize="10" Foreground="#88C0D0"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>
                            <!-- END Card -->

                            <!-- Make Winner overlay — revealed on mouse-over by DataTemplate.Triggers -->
                            <Border x:Name="MakeWinnerOverlay"
                                    CornerRadius="4"
                                    Background="#D02E3440"
                                    Visibility="Hidden">
                                <Button Content="Make Winner"
                                        Style="{StaticResource MakeWinnerButtonStyle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="MakeWinner_Click"/>
                            </Border>

                        </Grid>
                        <!-- END outer grid -->

                        <DataTemplate.Triggers>
                            <Trigger SourceName="CardGrid" Property="IsMouseOver" Value="True">
                                <Setter TargetName="MakeWinnerOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#242933" Padding="16,8">
            <TextBlock Text="Files are listed in SkyPatcher load order — last file wins.  Hover a card and click  Make Winner  to comment out the conflicting rules in all other files."
                       FontSize="10" Foreground="#4C566A" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
