<Window x:Class="SkyScope.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyScope - SkyPatcher Conflict Detector"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#2E3440">

    <Window.Resources>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#88C0D0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ConflictBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#BF616A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#3B4252"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B5CEA0"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4C566A"/>
                                <Setter Property="Foreground" Value="#6C7A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#4C566A"/>
            <Setter Property="Foreground" Value="#D8DEE9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5C6880"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#7090BC"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4C566A"/>
                    <Setter Property="Foreground" Value="#6C7A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Invisible thumb for column resize dragging -->
        <Style x:Key="ColumnGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column header with ▲/▼ sort indicator -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E3440"/>
            <Setter Property="Foreground" Value="#88C0D0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                    <TextBlock x:Name="SortArrow" Grid.Column="1"
                                               Margin="4,0,2,0" FontSize="8"
                                               Foreground="#88C0D0"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnGripperStyle}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#3B4252"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row: full-row hover + selection. NOTE: no RowBackground on the DataGrid so
             these style triggers are not overridden by a local value. -->
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#434C5E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4C566A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell: transparent so row background shows through -->
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Winner column: green accent, slightly smaller -->
        <Style x:Key="WinnerCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="Foreground" Value="#A3BE8C"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- Panel splitter between the three result sections -->
        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Line" Height="1" VerticalAlignment="Center"
                                    Background="#3B4252" Opacity="0.7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="#88C0D0"/>
                                <Setter TargetName="Line" Property="Opacity" Value="1"/>
                                <Setter TargetName="Line" Property="Height" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#242933" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SkyScope" FontSize="22" FontWeight="Bold" Foreground="#ECEFF4"/>
                    <TextBlock Text="SkyPatcher NPC Overhaul Conflict Detector" FontSize="11" Foreground="#88C0D0" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                        <TextBlock Text="FILES SCANNED" FontSize="9" Foreground="#4C566A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FilesScannedText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#81A1C1" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                        <TextBlock Text="APPEARANCE" FontSize="9" Foreground="#4C566A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AppearanceCountText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#EBCB8B" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                        <TextBlock Text="SKIN" FontSize="9" Foreground="#4C566A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SkinCountText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#D08770" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="OUTFIT" FontSize="9" Foreground="#4C566A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OutfitCountText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#B48EAD" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings panel -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Configuration" FontSize="12" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,0,0,12"/>

                    <TextBlock Text="Skyrim Directory" FontSize="10" Foreground="#88C0D0" Margin="0,0,0,4"/>
                    <TextBlock Text="Scans Data\SKSE\Plugins\SkyPatcher\npc and \outfit recursively."
                               FontSize="9" Foreground="#4C566A" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SkyrimPathTextBox"
                                 Grid.Column="0" Height="28"
                                 VerticalContentAlignment="Center" Padding="6,0"
                                 Background="#2E3440" Foreground="#ECEFF4"
                                 CaretBrush="#ECEFF4" BorderBrush="#4C566A"
                                 BorderThickness="1" FontSize="10"/>
                        <Button Grid.Column="1" Content="…"
                                Width="28" Height="28" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BrowseButton_Click"
                                ToolTip="Browse for Skyrim directory"/>
                    </Grid>

                    <Button x:Name="AnalyzeButton" Content="Analyze Mods"
                            Height="36" Margin="0,10,0,6"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AnalyzeButton_Click"/>
                    <Button x:Name="SaveSettingsButton" Content="Save Settings"
                            Height="30" Margin="0,0,0,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveSettingsButton_Click"/>
                    <Button x:Name="ExportReportButton" Content="Export Report"
                            Height="30" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ExportReportButton_Click"/>

                    <TextBlock x:Name="StatusTextBlock" Text="Ready"
                               FontSize="10" Foreground="#88C0D0"
                               Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Three resizable conflict sections -->
            <Grid x:Name="ResultsGrid" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="AppearanceRow" Height="*" MinHeight="62"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="SkinRow"       Height="*" MinHeight="62"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="OutfitRow"     Height="*" MinHeight="62"/>
                </Grid.RowDefinitions>

                <!-- Filter bar -->
                <Border Grid.Row="0" Background="#313744" CornerRadius="4" Margin="0,0,0,8">
                    <Grid>
                        <TextBox x:Name="FilterTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#ECEFF4" CaretBrush="#ECEFF4"
                                 FontSize="11" Height="32" VerticalContentAlignment="Center"
                                 Padding="30,0,8,0"
                                 TextChanged="FilterTextBox_TextChanged"/>
                        <TextBlock Text="No results match the current filter."
                                   x:Name="FilterNoMatchText"
                                   FontSize="10" Foreground="#4C566A"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,10,0" IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="Filter results…"
                                   FontSize="11" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="30,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" FontSize="15" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Appearance conflicts -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Appearance Conflicts  (copyVisualStyle)" Style="{StaticResource SectionHeaderStyle}"/>
                            <Border x:Name="AppearanceBadge" Style="{StaticResource ConflictBadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="AppearanceBadgeText" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="AppearanceEmptyText" Grid.Row="1"
                                   Text="No appearance conflicts detected."
                                   FontSize="10" Foreground="#4C566A"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <DataGrid x:Name="AppearanceDataGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  RowHeight="38" CanUserSortColumns="True"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  Visibility="Collapsed"
                                  ScrollViewer.CanContentScroll="True"
                                  CanUserResizeRows="False" CanUserReorderColumns="False"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NPC"    Binding="{Binding DisplayName}"    Width="*"   ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Winner" Binding="{Binding WinnerFileName}" Width="170" ElementStyle="{StaticResource WinnerCellStyle}"/>
                                <DataGridTextColumn Header="Files"  Binding="{Binding FileCount}"      Width="54"  ElementStyle="{StaticResource CellTextStyle}"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Splitter 1 -->
                <GridSplitter Grid.Row="2" Height="8"
                              Style="{StaticResource SplitterStyle}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS"/>

                <!-- Skin conflicts -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Skin Conflicts  (skin)" Style="{StaticResource SectionHeaderStyle}"/>
                            <Border x:Name="SkinBadge" Style="{StaticResource ConflictBadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="SkinBadgeText" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SkinEmptyText" Grid.Row="1"
                                   Text="No skin conflicts detected."
                                   FontSize="10" Foreground="#4C566A"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <DataGrid x:Name="SkinDataGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  RowHeight="38" CanUserSortColumns="True"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  Visibility="Collapsed"
                                  ScrollViewer.CanContentScroll="True"
                                  CanUserResizeRows="False" CanUserReorderColumns="False"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NPC"    Binding="{Binding DisplayName}"    Width="*"   ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Winner" Binding="{Binding WinnerFileName}" Width="170" ElementStyle="{StaticResource WinnerCellStyle}"/>
                                <DataGridTextColumn Header="Files"  Binding="{Binding FileCount}"      Width="54"  ElementStyle="{StaticResource CellTextStyle}"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Splitter 2 -->
                <GridSplitter Grid.Row="4" Height="8"
                              Style="{StaticResource SplitterStyle}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS"/>

                <!-- Default outfit conflicts -->
                <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Default Outfit Conflicts  (outfitDefault)" Style="{StaticResource SectionHeaderStyle}"/>
                            <Border x:Name="OutfitBadge" Style="{StaticResource ConflictBadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="OutfitBadgeText" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="OutfitEmptyText" Grid.Row="1"
                                   Text="No default outfit conflicts detected."
                                   FontSize="10" Foreground="#4C566A"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <DataGrid x:Name="OutfitDataGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  RowHeight="38" CanUserSortColumns="True"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  Visibility="Collapsed"
                                  ScrollViewer.CanContentScroll="True"
                                  CanUserResizeRows="False" CanUserReorderColumns="False"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NPC"    Binding="{Binding DisplayName}"    Width="*"   ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Winner" Binding="{Binding WinnerFileName}" Width="170" ElementStyle="{StaticResource WinnerCellStyle}"/>
                                <DataGridTextColumn Header="Files"  Binding="{Binding FileCount}"      Width="54"  ElementStyle="{StaticResource CellTextStyle}"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#242933" Padding="16,8">
            <TextBlock Text="SkyScope — double-click a row to see conflict details  ·  hover for a quick summary  ·  drag the dividers to resize  ·  click a column header to sort"
                       FontSize="10" Foreground="#4C566A"/>
        </Border>
    </Grid>
</Window>
