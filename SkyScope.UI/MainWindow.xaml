<Window x:Class="SkyScope.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyScope.UI"
        Title="SkyScope - Runtime Injector Conflict Finder"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#2E3440">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#88C0D0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ConflictBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#BF616A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#3B4252"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B5CEA0"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4C566A"/>
                                <Setter Property="Foreground" Value="#6C7A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#4C566A"/>
            <Setter Property="Foreground" Value="#D8DEE9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5C6880"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#7090BC"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4C566A"/>
                    <Setter Property="Foreground" Value="#6C7A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#BF616A"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CF7177"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Invisible thumb for column resize dragging -->
        <Style x:Key="ColumnGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column header with ▲/▼ sort indicator -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E3440"/>
            <Setter Property="Foreground" Value="#88C0D0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                    <TextBlock x:Name="SortArrow" Grid.Column="1"
                                               Margin="4,0,2,0" FontSize="8"
                                               Foreground="#88C0D0"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnGripperStyle}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#3B4252"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row: full-row hover + selection. NOTE: no RowBackground on the DataGrid so
             these style triggers are not overridden by a local value. -->
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#434C5E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4C566A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell: transparent so row background shows through -->
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Winner column: green accent, slightly smaller -->
        <Style x:Key="WinnerCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="Foreground" Value="#A3BE8C"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- Panel splitter between the three result sections -->
        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Line" Height="1" VerticalAlignment="Center"
                                    Background="#3B4252" Opacity="0.7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="#88C0D0"/>
                                <Setter TargetName="Line" Property="Opacity" Value="1"/>
                                <Setter TargetName="Line" Property="Height" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NordTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#2E3440"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="NordTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#2E3440"/>
            <Setter Property="Foreground" Value="#8C9BB5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8,16,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Tab" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" Cursor="Hand">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Rectangle x:Name="Indicator" Height="2"
                                       VerticalAlignment="Bottom" Fill="#88C0D0"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#3E4757"/>
                                <Setter TargetName="Tab" Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#3B4252"/>
                                <Setter Property="Foreground" Value="#ECEFF4"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Tab" Property="Background" Value="#353D4C"/>
                                    <Setter Property="Foreground" Value="#B0BFCF"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#242933" Padding="20,14">
            <StackPanel>
                <TextBlock Text="SkyScope" FontSize="22" FontWeight="Bold" Foreground="#ECEFF4"/>
                <TextBlock Text="Runtime Injector Conflict Finder" FontSize="11" Foreground="#88C0D0" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabbed main content -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Style="{StaticResource NordTabControl}"
                    ItemContainerStyle="{StaticResource NordTabItem}">

            <!-- Tab 1: Skyrim Config (always enabled) -->
            <TabItem Header="Skyrim Config">
            <Grid Margin="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Configuration" FontSize="12" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,0,0,12"/>

                        <TextBlock Text="Skyrim Directory" FontSize="10" Foreground="#88C0D0" Margin="0,0,0,4"/>
                        <TextBlock Text="Scans Data\SKSE\Plugins\SkyPatcher\npc and \outfit recursively, plus Data\*_DISTR.ini for SPID rules."
                                   FontSize="9" Foreground="#8C9BB5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SkyrimPathTextBox"
                                     Grid.Column="0" Height="28"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     Background="#2E3440" Foreground="#ECEFF4"
                                     CaretBrush="#ECEFF4" BorderBrush="#4C566A"
                                     BorderThickness="1" FontSize="10"/>
                            <Button Grid.Column="1" Content="…"
                                    Width="28" Height="28" Margin="4,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseButton_Click"
                                    ToolTip="Browse for Skyrim directory"/>
                        </Grid>

                        <Button x:Name="AnalyzeButton" Content="Analyze Mods"
                                Height="36" Margin="0,10,0,6"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AnalyzeButton_Click"/>
                        <Button x:Name="ExportReportButton" Content="Export Report"
                                Height="30" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ExportReportButton_Click"/>

                        <TextBlock x:Name="StatusTextBlock" Text="Ready"
                                   FontSize="10" Foreground="#88C0D0"
                                   Margin="0,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
            </TabItem>

            <!-- Tab 2: Report (disabled until analysis) -->
            <TabItem x:Name="ReportTab" Header="Report" IsEnabled="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                <StackPanel>

                    <!-- Placeholder shown before first analysis -->
                    <TextBlock x:Name="ReportPlaceholderText"
                               Text="Run an analysis to see a conflict summary."
                               FontSize="12" Foreground="#4C566A"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Margin="0,40,0,0"/>

                    <!-- Summary panels — hidden until analysis completes -->
                    <StackPanel x:Name="ReportSummaryPanel" Visibility="Collapsed">

                        <!-- Scan Summary -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Scan Summary" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header row -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Files Scanned"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#88C0D0"
                                               HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="w/ Rules"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#88C0D0"
                                               HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Rules Parsed"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#88C0D0"
                                               HorizontalAlignment="Right" Margin="0,0,0,6"/>

                                    <!-- Divider -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="4"
                                            Height="1" Background="#3B4252" Margin="0,0,0,4"/>

                                    <!-- SkyPatcher -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SkyPatcher"
                                               FontSize="11" Foreground="#88C0D0" Margin="0,3,16,3"/>
                                    <TextBlock x:Name="SkyPatcherFilesText" Grid.Row="2" Grid.Column="1" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock x:Name="SkyPatcherSupportedText" Grid.Row="2" Grid.Column="2" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock x:Name="SkyPatcherRulesText" Grid.Row="2" Grid.Column="3" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>

                                    <!-- SPID -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SPID"
                                               FontSize="11" Foreground="#88C0D0" Margin="0,3,16,3"/>
                                    <TextBlock x:Name="SpidFilesText" Grid.Row="3" Grid.Column="1" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock x:Name="SpidSupportedText" Grid.Row="3" Grid.Column="2" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock x:Name="SpidRulesText" Grid.Row="3" Grid.Column="3" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>

                                    <!-- Base Object Swapper -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Base Object Swapper"
                                               FontSize="11" Foreground="#88C0D0" Margin="0,3,16,3"/>
                                    <TextBlock x:Name="BosFilesText" Grid.Row="4" Grid.Column="1" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock x:Name="BosSupportedText" Grid.Row="4" Grid.Column="2" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock x:Name="BosRulesText" Grid.Row="4" Grid.Column="3" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>

                                    <!-- Divider -->
                                    <Border Grid.Row="5" Grid.ColumnSpan="4"
                                            Height="1" Background="#4C566A" Margin="0,6"/>

                                    <!-- NPC database records -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="NPC database records"
                                               FontSize="11" Foreground="#88C0D0" Margin="0,3,16,3"/>
                                    <TextBlock x:Name="NpcDbRecordsText" Grid.Row="6" Grid.Column="1" Text="—"
                                               FontSize="11" Foreground="#ECEFF4" FontWeight="Bold"
                                               HorizontalAlignment="Right" Margin="0,3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Conflicts Found -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Conflicts Found" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Appearance -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#EBCB8B" CornerRadius="3" Width="16" Height="16" Margin="0,4,8,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Appearance" FontSize="11" Foreground="#88C0D0" Margin="0,4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AppearanceSummaryText" Grid.Row="0" Grid.Column="2" Text="—" FontSize="11" Foreground="#ECEFF4" Margin="0,4" VerticalAlignment="Center"/>

                                    <!-- Skin -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#D08770" CornerRadius="3" Width="16" Height="16" Margin="0,4,8,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Skin" FontSize="11" Foreground="#88C0D0" Margin="0,4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SkinSummaryText" Grid.Row="1" Grid.Column="2" Text="—" FontSize="11" Foreground="#ECEFF4" Margin="0,4" VerticalAlignment="Center"/>

                                    <!-- Outfit -->
                                    <Border Grid.Row="2" Grid.Column="0" Background="#B48EAD" CornerRadius="3" Width="16" Height="16" Margin="0,4,8,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Default Outfit" FontSize="11" Foreground="#88C0D0" Margin="0,4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OutfitSummaryText" Grid.Row="2" Grid.Column="2" Text="—" FontSize="11" Foreground="#ECEFF4" Margin="0,4" VerticalAlignment="Center"/>

                                    <!-- Spell -->
                                    <Border Grid.Row="3" Grid.Column="0" Background="#A3BE8C" CornerRadius="3" Width="16" Height="16" Margin="0,4,8,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Spells" FontSize="11" Foreground="#88C0D0" Margin="0,4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SpellSummaryText" Grid.Row="3" Grid.Column="2" Text="—" FontSize="11" Foreground="#ECEFF4" Margin="0,4" VerticalAlignment="Center"/>

                                    <!-- Perk -->
                                    <Border Grid.Row="4" Grid.Column="0" Background="#BF616A" CornerRadius="3" Width="16" Height="16" Margin="0,4,8,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Perks" FontSize="11" Foreground="#88C0D0" Margin="0,4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PerkSummaryText" Grid.Row="4" Grid.Column="2" Text="—" FontSize="11" Foreground="#ECEFF4" Margin="0,4" VerticalAlignment="Center"/>

                                    <!-- Base Object Swapper -->
                                    <Border Grid.Row="5" Grid.Column="0" Background="#88C0D0" CornerRadius="3" Width="16" Height="16" Margin="0,4,8,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Swapped Objects" FontSize="11" Foreground="#88C0D0" Margin="0,4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BosSummaryText" Grid.Row="5" Grid.Column="2" Text="—" FontSize="11" Foreground="#ECEFF4" Margin="0,4" VerticalAlignment="Center"/>
                                </Grid>

                                <Border BorderBrush="#3B4252" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                    <TextBlock x:Name="TotalSummaryText" Text="—"
                                               FontSize="12" FontWeight="Bold" Foreground="#88C0D0"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Notes" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                                <TextBlock FontSize="10" Foreground="#88C0D0" TextWrapping="Wrap" LineHeight="18">
                                    <Run FontWeight="Bold" Foreground="#ECEFF4">Appearance / Skin / Outfit</Run>
                                    <Run> — winner-takes-all rules. The last file by SkyPatcher load order wins. Use the NPC Conflicts tab to review sources and make a file the winner.</Run>
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#88C0D0" TextWrapping="Wrap" LineHeight="18">
                                    <Run FontWeight="Bold" Foreground="#ECEFF4">Spells / Perks</Run>
                                    <Run> — additive rules from SkyPatcher (spellsToAdd / perksToAdd) and SPID (Spell= / Perk=). All matching rules apply, so multiple mods targeting the same NPC may add duplicate or conflicting distributions, but may not be true conflicts really.</Run>
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#88C0D0" TextWrapping="Wrap" LineHeight="18">
                                    <Run FontWeight="Bold" Foreground="#ECEFF4">Base Object Swapper</Run>
                                    <Run> — winner-takes-all rules from *_SWAP.ini files. Files are loaded in case-sensitive alphabetical order; the last filename alphabetically wins. Use the BOS Conflicts tab to review sources.</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </TabItem>

            <TabItem x:Name="NpcTab" Header="NPCs" IsEnabled="False">
                <Grid Margin="16">
                    <local:NpcConflictView x:Name="NpcConflictViewControl"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="BosTab" Header="Base Object Swapper" IsEnabled="False">
                <Grid Margin="16">
                    <local:BosConflictView x:Name="BosConflictViewControl"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="HistoryTab" Header="History">
                <Grid Margin="16">
                    <local:HistoryView x:Name="HistoryViewControl"/>
                </Grid>
            </TabItem>

            <!-- Tab: Settings (always enabled) -->
            <TabItem x:Name="SettingsTab" Header="Settings">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card: Ignored Plugins -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ignored Plugins"
                                       FontSize="12" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1"
                                       Text="Plugins listed here are excluded from appearance-conflict detection — their NPC appearance overrides won't appear as 'Plugin' sources. Creation Club (cc*) content is always excluded. Changes apply on the next analysis."
                                       FontSize="10" Foreground="#8C9BB5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Add row -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IgnoredPluginInput" Grid.Column="0"
                                         Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                         Background="#2E3440" Foreground="#ECEFF4"
                                         CaretBrush="#ECEFF4" BorderBrush="#4C566A"
                                         BorderThickness="1" FontSize="10"
                                         ToolTip="Enter a plugin filename, e.g. SomeMod.esp"/>
                                <Button Grid.Column="1" Content="Add" Width="80" Height="28" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="AddIgnoredPlugin_Click"/>
                            </Grid>

                            <!-- Ignored plugin list -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                <ItemsControl x:Name="IgnoredPluginList" Margin="0,0,8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}"
                                                           FontSize="11" Foreground="#ECEFF4"
                                                           VerticalAlignment="Center" Margin="2,0,8,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Background="Transparent"
                                                           Cursor="Hand"
                                                           MouseLeftButtonUp="CopyPluginName_Click"
                                                           ToolTip="Click to copy the plugin name"/>
                                                <Button Grid.Column="1"
                                                        Width="28" Height="28"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Tag="{Binding}"
                                                        Click="RemoveIgnoredPlugin_Click"
                                                        ToolTip="Remove from ignored plugins">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Fill="#ECEFF4"
                                                              Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Card: Appearance Thumbnails -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Appearance Thumbnails"
                                       FontSize="12" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1"
                                       Text="Choose a folder of portrait images for each plugin referenced by the appearance conflicts. Plugins are added automatically after each analysis; saved entries persist across launches."
                                       FontSize="10" Foreground="#8C9BB5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Column headers -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Plugin"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#88C0D0" Margin="2,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Thumbnail Folder"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#88C0D0" Margin="2,0,0,0"/>
                            </Grid>

                            <!-- Plugin list -->
                            <Grid Grid.Row="3">
                                <TextBlock x:Name="SettingsEmptyText"
                                           Text="No appearance plugins yet. Run an analysis to discover them."
                                           FontSize="11" Foreground="#4C566A"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PluginThumbnailList" Margin="0,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PluginName}"
                                                               FontSize="11" Foreground="#ECEFF4"
                                                               VerticalAlignment="Center" Margin="2,0,8,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Background="Transparent"
                                                               Cursor="Hand"
                                                               MouseLeftButtonUp="CopyPluginName_Click"
                                                               ToolTip="Click to copy the plugin name"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Directory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                                             Background="#2E3440" Foreground="#ECEFF4"
                                                             CaretBrush="#ECEFF4" BorderBrush="#4C566A"
                                                             BorderThickness="1" FontSize="10"/>
                                                    <Button Grid.Column="2" Content="…"
                                                            Width="28" Height="28" Margin="4,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Tag="{Binding}"
                                                            Click="BrowseThumbnailDir_Click"
                                                            ToolTip="Browse for a thumbnail folder"/>
                                                    <!-- Delete: only for folders persisted in settings.json -->
                                                    <Button Grid.Column="3"
                                                            Width="28" Height="28" Margin="4,0,0,0"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Tag="{Binding}"
                                                            Click="DeleteThumbnailDir_Click"
                                                            ToolTip="Remove this saved thumbnail folder"
                                                            Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}">
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Fill="#ECEFF4"
                                                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Save row -->
                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsStatusText" Grid.Column="0"
                                           FontSize="10" Foreground="#88C0D0"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                <Button x:Name="SaveAppSettingsButton" Grid.Column="1"
                                        Content="Save Settings" Width="130" Height="32"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveAppSettingsButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#242933" Padding="16,8">
            <Grid>
                <TextBlock Text="SkyScope — Report tab shows a summary overview  ·  use the NPC Conflicts tab to review and resolve individual conflicts"
                           FontSize="10" Foreground="#4C566A" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionTextBlock"
                           FontSize="10" Foreground="#4C566A"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Toast notification (top-right overlay, shown via ShowToast) -->
        <Border x:Name="ToastNotification" Grid.RowSpan="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0" Panel.ZIndex="100"
                Background="#434C5E" CornerRadius="6" Padding="14,10"
                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Fill="#A3BE8C" Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </Viewbox>
                <TextBlock x:Name="ToastText" Text="Copied to clipboard"
                           FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF4"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
