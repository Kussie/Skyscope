<local:ConflictViewBase x:Class="SkyScope.UI.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyScope.UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConflictViewResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: search + diff mode toggle + count -->
        <Border Grid.Row="0" Background="#313744" CornerRadius="4" Margin="0,0,0,8" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Border Grid.Column="0" Background="#2E3440" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#ECEFF4" CaretBrush="#ECEFF4"
                                 FontSize="11" Height="28" VerticalContentAlignment="Center"
                                 Padding="28,0,8,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Search history…" FontSize="11" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="28,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" FontSize="15" Foreground="#4C566A"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Diff mode toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="InlineDiffButton" Content="Inline diff"
                            Click="InlineDiffButton_Click"
                            FontSize="10" FontWeight="SemiBold" Padding="8,4"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4C566A"/>
                                <Setter Property="Foreground" Value="#88C0D0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="3,0,0,3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInlineDiff}" Value="True">
                                        <Setter Property="Background" Value="#5E81AC"/>
                                        <Setter Property="Foreground" Value="#ECEFF4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BeforeAfterButton" Content="Before / After"
                            Click="BeforeAfterButton_Click"
                            FontSize="10" FontWeight="SemiBold" Padding="8,4"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4C566A"/>
                                <Setter Property="Foreground" Value="#88C0D0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="0,3,3,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBeforeAfter}" Value="True">
                                        <Setter Property="Background" Value="#5E81AC"/>
                                        <Setter Property="Foreground" Value="#ECEFF4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="RecordCountText" Grid.Column="2"
                           FontSize="10" Foreground="#8C9BB5"
                           VerticalAlignment="Center" Margin="0,0,2,0"/>
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="No changes recorded yet."
                   FontSize="11" Foreground="#4C566A"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="Visible"/>

        <!-- History list (virtualized) -->
        <ItemsControl x:Name="HistoryList" Grid.Row="1"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ConflictItemContainer}">
                        <StackPanel>

                            <!-- Header row (clickable accordion) -->
                            <Button Tag="{Binding}" Click="ConflictHeader_Click"
                                    Style="{StaticResource ConflictHeaderButton}">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp}"
                                               FontSize="10" Foreground="#8C9BB5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- File + description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF4"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ConflictDescription}"
                                                   FontSize="10" Foreground="#B8C5D5" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConflictDescription}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Status badge -->
                                    <Border Grid.Column="2" CornerRadius="3"
                                            Padding="5,2" Margin="4,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4C566A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Applied">
                                                        <Setter Property="Background" Value="#A3BE8C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="NotFound">
                                                        <Setter Property="Background" Value="#BF616A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="9" FontWeight="Bold" Foreground="#2E3440"/>
                                    </Border>

                                    <!-- Chevron -->
                                    <TextBlock Grid.Column="3"
                                               FontSize="9" Foreground="#4C566A"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▼"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <!-- Accordion panel -->
                            <Border Style="{StaticResource ConflictAccordionPanel}">
                                <StackPanel Margin="12,4,12,12">

                                    <!-- Modification type + change code -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding ModificationLabel}"
                                                   FontSize="9" FontWeight="SemiBold" Foreground="#88C0D0"/>
                                        <Border Background="#2E3440" CornerRadius="2"
                                                Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="9" Foreground="#4C566A" FontFamily="Consolas">
                                                <Run Text="["/>
                                                <Run Text="{Binding ChangeCode, Mode=OneWay}"/>
                                                <Run Text="]"/>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding SourceTool}"
                                                   FontSize="9" Foreground="#4C566A"
                                                   Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceTool}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- ── Inline diff panel ── -->
                                    <ItemsControl ItemsSource="{Binding DiffLines}"
                                                  Visibility="{Binding IsInlineDiff,
                                                      RelativeSource={RelativeSource AncestorType=local:HistoryView},
                                                      Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1,0,0" CornerRadius="2" Padding="6,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                                    <Setter Property="Background" Value="{StaticResource DiffRemovedBackground}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                                    <Setter Property="Background" Value="{StaticResource DiffAddedBackground}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Gutter}"
                                                                   FontFamily="Consolas" FontSize="10"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                                            <Setter Property="Foreground" Value="{StaticResource DiffRemovedForeground}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                                            <Setter Property="Foreground" Value="{StaticResource DiffAddedForeground}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Text}"
                                                                   FontFamily="Consolas" FontSize="10"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                                            <Setter Property="Foreground" Value="{StaticResource DiffRemovedForeground}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                                            <Setter Property="Foreground" Value="{StaticResource DiffAddedForeground}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- ── Before / After panel ── -->
                                    <StackPanel Visibility="{Binding IsBeforeAfter,
                                                    RelativeSource={RelativeSource AncestorType=local:HistoryView},
                                                    Converter={StaticResource BoolToVis}}">

                                        <!-- BEFORE -->
                                        <TextBlock Text="BEFORE" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DiffRemovedForeground}"
                                                   Margin="0,0,0,2"/>
                                        <Border Background="{StaticResource DiffRemovedBackground}"
                                                CornerRadius="2" Padding="8,5" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding OriginalLine}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="{StaticResource DiffRemovedForeground}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- AFTER -->
                                        <TextBlock Text="AFTER" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DiffAddedForeground}"
                                                   Margin="0,0,0,2"/>
                                        <Border Background="{StaticResource DiffAddedBackground}"
                                                CornerRadius="2" Padding="8,5">
                                            <ItemsControl ItemsSource="{Binding ReplacementLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontFamily="Consolas" FontSize="10"
                                                                   Foreground="{StaticResource DiffAddedForeground}"
                                                                   TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>

                                    <!-- File path + action row -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FilePath}"
                                                   FontSize="9" Foreground="#8C99A8"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Revert button — visible only when CanRevert -->
                                        <Button Grid.Column="1" Content="Revert"
                                                Tag="{Binding}"
                                                Click="Revert_Click"
                                                Style="{StaticResource ConflictDangerButton}"
                                                Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</local:ConflictViewBase>
