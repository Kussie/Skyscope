<Window x:Class="SkyScope.UI.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portrait Preview"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#2E3440"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Border BorderBrush="#4C566A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: file name + close button -->
            <Border Grid.Row="0" Background="#242933" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaptionText" Grid.Column="0"
                               FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF4"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="✕" Width="26" Height="26"
                            Background="Transparent" BorderThickness="0" Foreground="#8C9BB5"
                            FontSize="12" Cursor="Hand"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Portrait (MaxWidth/MaxHeight set in code-behind to fit the screen's work area) -->
            <Border Grid.Row="1" Background="#1B1F27">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>
        </Grid>
    </Border>
</Window>
