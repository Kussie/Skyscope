<Window x:Class="SkyScope.UI.ModMatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match NPC Face Finder Mod"
        WindowStartupLocation="CenterOwner"
        Background="#2E3440"
        Width="440" Height="520"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ContextMenu x:Key="ModItemContextMenu"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open in Browser" Click="OpenModInBrowser_Click"
                      IsEnabled="{Binding HasExternalUrl}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PluginNameText" Grid.Row="0"
                   FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF4"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBox x:Name="SearchBox" Grid.Row="1"
                 Height="28" VerticalContentAlignment="Center" Padding="6,0"
                 Background="#3B4252" Foreground="#ECEFF4" CaretBrush="#ECEFF4"
                 BorderBrush="#4C566A" BorderThickness="1" FontSize="11"
                 Margin="0,0,0,8"
                 TextChanged="SearchBox_TextChanged"/>

        <ListBox x:Name="ModListBox" Grid.Row="2"
                 Background="#3B4252" Foreground="#ECEFF4" BorderBrush="#4C566A" BorderThickness="1"
                 DisplayMemberPath="DisplayText" FontSize="11"
                 MouseDoubleClick="ModListBox_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Tag" Value="{Binding}"/>
                    <Setter Property="ContextMenu" Value="{StaticResource ModItemContextMenu}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="3"
                   FontSize="10" Foreground="#8C9BB5" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Clear Match" Width="90" Height="28" Margin="0,0,8,0"
                    Background="#BF616A" Foreground="#ECEFF4" BorderThickness="0"
                    Click="Clear_Click"/>
            <Button Content="Cancel" Width="70" Height="28" Margin="0,0,8,0"
                    Background="#4C566A" Foreground="#ECEFF4" BorderThickness="0"
                    Click="Cancel_Click"/>
            <Button Content="OK" Width="70" Height="28" IsDefault="True"
                    Background="#5E81AC" Foreground="#ECEFF4" BorderThickness="0"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
